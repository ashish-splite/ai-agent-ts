{
  "name": "@ashish3020/ts-init",
  "version": "1.0.0",
  "description": "A reusable Bun and TypeScript application starter with infrastructure clients",
  "type": "module",
  "bin": {
    "ts-init": "bin/ts-init.js"
  },
  "files": [
    "bin/",
    "templates/",
    "src/",
    "config.sample.yaml",
    "tsconfig.json",
    "Dockerfile"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["typescript", "bun", "starter", "boilerplate", "scaffold"],
  "scripts": {
    "dev": "bun run --watch src/main.ts --app http",
    "start": "bun run src/main.ts --app http",
    "dev:worker:testing": "bun run --watch src/main.ts --app worker --workflow testing",
    "start:worker:testing": "bun run src/main.ts --app worker --workflow testing",
    "typecheck": "tsc --noEmit",
    "observability:traffic": "bun scripts/observability-traffic.js",
    "test:observability": "bun test tests/observability.test.ts",
    "test": "node --test tests/scaffold.test.js",
    "prepublishOnly": "bun run typecheck && npm test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/winston-transport": "0.34.0",
    "elysia": "^1.1.25",
    "ioredis": "^5.4.1",
    "openai": "^7.10.0",
    "postgres": "^3.4.7",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.3"
  }
}
