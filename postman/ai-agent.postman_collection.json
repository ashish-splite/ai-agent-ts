{
  "info": {
    "name": "AI Agent (Elysia + Bun)",
    "description": "Agent chat APIs. Run 'Start session' first — it stores the returned session id in the {{sessionId}} collection variable, which every other request reuses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Start session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('sessionId', body.id);",
              "console.log('sessionId =', body.id);",
              "",
              "pm.test('returns an empty session', () => {",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body.messageCount).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agent/start",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "start"]
        },
        "description": "Creates a new chat session and returns it. The test script saves the id to {{sessionId}}."
      }
    },
    {
      "name": "Send message",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('assistant replied', () => {",
              "  pm.expect(body.reply.role).to.eql('assistant');",
              "  pm.expect(body.reply.content).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Hi! My name is Ashish. Reply in one short sentence.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/agent/message",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "message"]
        },
        "description": "Sends a message and returns { session, reply }."
      }
    },
    {
      "name": "Send message - memory check",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"What is my name?\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/agent/message",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "message"]
        },
        "description": "Run after 'Send message' — the agent should recall the name from stored history."
      }
    },
    {
      "name": "Send message - trigger send_email tool",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Send an email to example@gmail.com with subject 'Hello' and body 'This is a test.' Go ahead and send it now.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/agent/message",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "message"]
        },
        "description": "Exercises the send_email tool. Requires GMAIL_USER and GMAIL_APP_PASSWORD; if the recipient is outside MAIL_ALLOWED_RECIPIENTS the agent will refuse."
      }
    },
    {
      "name": "List sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agent/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "sessions"]
        },
        "description": "Newest first, ordered by updatedAt."
      }
    },
    {
      "name": "Get session",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agent/session/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "session", "{{sessionId}}"]
        }
      }
    },
    {
      "name": "Get history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agent/history/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "history", "{{sessionId}}"]
        },
        "description": "Full transcript for the session."
      }
    },
    {
      "name": "Delete session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agent/session/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["agent", "session", "{{sessionId}}"]
        }
      }
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Unknown session - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agent/session/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "session", "does-not-exist"]
            }
          }
        },
        {
          "name": "Missing body field - 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/message",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "message"]
            },
            "description": "Schema validation failure — 'message' is absent."
          }
        },
        {
          "name": "Empty message - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"   \"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/message",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "message"]
            },
            "description": "Domain validation failure — blank message rejected by ChatService."
          }
        }
      ]
    }
  ]
}
